# ResumeX AI Environment Variables
# Copy this file to .env and set your LLM API Key

# Option A: Gemini / OpenAI / Custom LLM API Key
VITE_LLM_API_KEY=your_api_key_here

# Option B: Optional API Endpoint (Defaults to Google Gemini API)
VITE_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Option C: Enable Demo Mode Fallback for offline/competition presentations (true / false)
VITE_USE_DEMO_AI=false
